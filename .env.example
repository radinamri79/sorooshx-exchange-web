# ============================================
# SorooshX Frontend-Only Environment Variables
# ============================================
# This is a frontend-only Next.js application
# No backend, database, or external services required
#
# Public environment variables (prefixed with NEXT_PUBLIC_)
# are exposed to the browser at build time

# ============================================
# Frontend Configuration
# ============================================
# These are optional - the app works without them
# NEXT_PUBLIC_API_URL is not currently used (all data from Binance API)
# NEXT_PUBLIC_WS_URL is not currently used
# Keep these for future backend integration

# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# NEXT_PUBLIC_BINANCE_WS_URL=wss://fstream.binance.com

# ============================================
# Node Environment
# ============================================
# NODE_ENV=production  # Set automatically by build tools

# ============================================
# Notes for Vercel Deployment
# ============================================
# No environment variables are required for deployment to Vercel
# The frontend is a static Next.js app that connects directly to Binance API
# All trading logic runs client-side using Zustand store and localStorage
